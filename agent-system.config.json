{
  "version": 1,
  "adoptionStatus": "current",
  "runtime": {
    "setup": [["npm", "ci"]],
    "start": [["npm", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "3000"]],
    "healthcheck": [["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]],
    "smoke": [["node", "-e", "Promise.all(['/','/how-it-works','/insurance'].map(p=>fetch('http://127.0.0.1:3000'+p))).then(rs=>{if(rs.some(r=>!r.ok))process.exit(1)}).catch(()=>process.exit(1))"]],
    "stop": []
  },
  "validation": {
    "targeted": [["npm", "run", "lint"]],
    "full": [["node", "--test", "tools/agent/agent-tools.test.mjs"], ["npm", "run", "lint"], ["npm", "run", "build"]]
  },
  "hooks": {
    "fix": [],
    "check": [["npm", "run", "lint"], ["node", "--test", "tools/agent/agent-tools.test.mjs"]]
  },
  "review": {
    "timeoutSeconds": 180,
    "minimumDistinctFamilies": 2,
    "providers": [
      {
        "id": "claude-sonnet",
        "kind": "claude",
        "family": "anthropic",
        "model": "sonnet",
        "enabled": true
      },
      {
        "id": "opencode-mimo",
        "kind": "opencode",
        "family": "mimo",
        "model": "opencode/mimo-v2.5-free",
        "enabled": true
      },
      {
        "id": "codex-default",
        "kind": "codex",
        "family": "openai",
        "model": "configured-default",
        "enabled": true
      }
    ]
  },
  "nightShift": {
    "maxTasks": 3,
    "maxMinutes": 120,
    "maxRetriesPerTask": 2,
    "maxLlmRepairAttempts": 1,
    "stopOnDirtyStart": true
  },
  "llmRepair": {
    "enabled": false,
    "providerId": "",
    "timeoutSeconds": 180,
    "maxFiles": 10,
    "validation": []
  },
  "tests": {
    "inventory": "docs/agents/TEST_INVENTORY.md",
    "patterns": [".test.", ".spec.", "test_", "_test."]
  },
  "taskQueue": "TODOS.md",
  "performance": {
    "commands": [],
    "budgets": {}
  },
  "visual": {
    "enabled": true,
    "commands": []
  }
}
